.ruff_cache/
.coverage
htmlcov/

# --- Study databases: participant data never goes into git ---
*.sqlite3
*.sqlite3-*
*.sqlite3.*
data/test_databases/

# --- Large / third-party / regenerable data ---
data/raw/
data/.browser/
data/.downloads/
# Anchored with a leading slash: a bare `vendor/` also matched
# src/interface/static/vendor/, which holds the vendored three.js the task
# page imports. That kept three.module.min.js out of the repo and out of
# the Render build, so the 3D warehouse silently failed to render in
# production (canvas count 0, four 404s). Found 6 Oct 2026.
/vendor/
demo/output/
*.webm

# Kept on purpose (the app needs them at runtime):
#   models/live_risk_lgbm.txt, models/live_risk_meta.json
#   data/processed/fitted_params.json, data/processed/m5_weekly.npy

# --- Deploy / tooling ---
.firebase/
firebase-debug.log
*-debug.log
deploy/.secrets/
cloud-sql-proxy*
exports/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Azure deploy: contains the database password written by deploy-azure.sh
deploy/.azure-db-url
data/export-*.sql

# --- Added 5 Oct 2026, before the first commit ---
# Without these, `git add .` commits ~750 MB of regenerable or re-installable
# files. Nothing here is needed to run, deploy or analyse the study.
node_modules/
web/.next/
# Narrated-demo build products: narration.wav 55 MB, raw.webm 31 MB,
# Reliance_Under_Disruption_demo.mp4 23 MB. Rebuild with
# demo/narrated/make_narrated_demo.py; keep the mp4 outside git.
demo/narrated/output/
# Regenerable feature corpus (~14 MB). fitted_params.json and m5_weekly.npy
# are NOT ignored -- the app loads both at runtime.
data/processed/corpus*.csv

# web/ is a separate shadcn side project and still has its own .git, so the
# parent repo would record it as a broken submodule. It is NOT part of the
# study app (the deployed image contains only src/, models/ and two files from
# data/processed). Delete web/.git and remove this line if you want it tracked.
/web/

# --- Copyrighted source PDFs: read locally, never redistributed ---
# ~70 MB of publisher PDFs. They are inputs to the literature review, not to
# the app, and each is retrievable by DOI. The reviews that matter are kept as
# text in docs/paper-reviews/. See RESULTS.md and LINKS.md for the citations.
lightgbm-pivot/papers/
*.pdf

# Working screenshot, not a project artefact.
screen.png

# internal documents: feedback, the conference template (redistribution) and planning notes
paper/feedback of paper.docx
paper/AHFE template 2026.docx
paper/AHFE_471_Execution_Plan.docx

# kept private (19 Oct 2026): the manuscript and its drafts until published, and local
# agent / planning files. They stay on disk; they are not part of the public repository.
paper/
docs/AHFE-471-PAPER-*
Document (14)*.docx
LINKS.md
docs/run-plan.html
.claude/
CLAUDE.md
.mcp.json
